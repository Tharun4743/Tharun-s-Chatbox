DATABASE_URL="your-neon-database-url"
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# App
NEXT_PUBLIC_APP_NAME="Techy Tharun's Chatbox"

# -------------------------------------------------------
# AI PROVIDER KEYS — comma-separated for multi-key rotation
# Priority order: Groq → OpenRouter → OpenAI
# -------------------------------------------------------

# Groq (fastest, free tier) — add multiple keys separated by commas
GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3

# OpenRouter (fallback) — add multiple keys separated by commas
OPENROUTER_API_KEYS=sk-or-v1-key1,sk-or-v1-key2

# OpenAI (final fallback) — add multiple keys separated by commas
OPENAI_API_KEYS=sk-proj-key1,sk-proj-key2
