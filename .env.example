# ChatBox Environment Variables - Example

# OpenRouter API
OPENROUTER_API_KEY=

# Neon PostgreSQL (free at https://neon.tech)
DATABASE_URL=
DIRECT_URL=

# Auth.js
NEXTAUTH_URL=https://your-domain.vercel.app
NEXTAUTH_SECRET=

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# App
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
NEXT_PUBLIC_APP_NAME=ChatBox
